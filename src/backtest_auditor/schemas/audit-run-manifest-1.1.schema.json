{
  "$id": "urn:backtest-integrity-auditor:schema:audit-run-manifest:1.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_id": {
      "type": "string"
    },
    "audit_timestamp_utc": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "audit_type": {
      "enum": [
        "experiment_family",
        "single_run"
      ]
    },
    "configuration": {
      "additionalProperties": true,
      "type": "object"
    },
    "configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "platform_machine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform_system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "python_implementation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "python_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "dependencies",
        "platform_machine",
        "platform_system",
        "python_implementation",
        "python_version"
      ],
      "type": "object"
    },
    "git_commit": {
      "type": "string"
    },
    "input_artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "file_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "file_name",
          "role",
          "sha256",
          "size_bytes"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "manifest_schema_version": {
      "const": "1.1"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "method_versions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "normalized_data_encoding": {
      "type": "string"
    },
    "normalized_data_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "package_version": {
      "type": "string"
    },
    "random_seeds": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "type": "object"
    },
    "report_schema_version": {
      "const": "2.5"
    },
    "subject_id": {
      "type": "string"
    },
    "warnings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "audit_id",
    "audit_timestamp_utc",
    "audit_type",
    "configuration",
    "configuration_sha256",
    "environment",
    "git_commit",
    "input_artifacts",
    "manifest_schema_version",
    "manifest_sha256",
    "method_versions",
    "normalized_data_encoding",
    "normalized_data_sha256",
    "package_version",
    "random_seeds",
    "report_schema_version",
    "subject_id",
    "warnings"
  ],
  "title": "Backtest Integrity Auditor Audit-Run Manifest 1.1",
  "type": "object"
}
