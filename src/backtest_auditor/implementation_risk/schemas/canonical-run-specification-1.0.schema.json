{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backtest-integrity-auditor.local/schemas/implementation-risk/canonical-run-specification-1.0.schema.json",
  "title": "Canonical implementation-risk run specification 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["simulation", "specification_schema_version", "strategy"],
  "properties": {
    "specification_schema_version": {"const": "1.0"},
    "strategy": {"$ref": "#/$defs/strategy"},
    "simulation": {"$ref": "#/$defs/simulation"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "nullableString": {
      "oneOf": [{"$ref": "#/$defs/nonEmptyString"}, {"type": "null"}]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit", "value", "value_type"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "unit": {"$ref": "#/$defs/nullableString"},
        "value_type": {
          "enum": ["boolean", "decimal", "integer", "null", "string"]
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {"properties": {"value_type": {"const": "boolean"}}},
          "then": {"properties": {"value": {"type": "boolean"}}}
        },
        {
          "if": {"properties": {"value_type": {"const": "decimal"}}},
          "then": {"properties": {"value": {"$ref": "#/$defs/decimal"}}}
        },
        {
          "if": {"properties": {"value_type": {"const": "integer"}}},
          "then": {"properties": {"value": {"type": "integer"}}}
        },
        {
          "if": {"properties": {"value_type": {"const": "null"}}},
          "then": {"properties": {"value": {"type": "null"}}}
        },
        {
          "if": {"properties": {"value_type": {"const": "string"}}},
          "then": {"properties": {"value": {"$ref": "#/$defs/nonEmptyString"}}}
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_sha256", "name", "parameters", "version"],
      "properties": {
        "implementation_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/$defs/parameter"}
        },
        "version": {"$ref": "#/$defs/nullableString"}
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_class",
        "attributes",
        "contract_multiplier",
        "currency",
        "instrument_id",
        "symbol",
        "venue"
      ],
      "properties": {
        "asset_class": {
          "enum": [
            "bond",
            "cash",
            "crypto",
            "equity",
            "etf",
            "forex",
            "fund",
            "future",
            "index",
            "option",
            "other"
          ]
        },
        "attributes": {
          "type": "array",
          "items": {"$ref": "#/$defs/parameter"}
        },
        "contract_multiplier": {"$ref": "#/$defs/decimal"},
        "currency": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{2,11}$"},
        "instrument_id": {"$ref": "#/$defs/nonEmptyString"},
        "symbol": {"$ref": "#/$defs/nonEmptyString"},
        "venue": {"$ref": "#/$defs/nullableString"}
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_frequency",
        "logic_sha256",
        "name",
        "parameters",
        "signal_model",
        "signal_timing",
        "sizing_model",
        "strategy_id",
        "universe",
        "version"
      ],
      "properties": {
        "data_frequency": {"$ref": "#/$defs/nonEmptyString"},
        "logic_sha256": {"$ref": "#/$defs/sha256"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/$defs/parameter"}
        },
        "signal_model": {"$ref": "#/$defs/model"},
        "signal_timing": {"$ref": "#/$defs/nonEmptyString"},
        "sizing_model": {"$ref": "#/$defs/model"},
        "strategy_id": {"$ref": "#/$defs/nonEmptyString"},
        "universe": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/instrument"}
        },
        "version": {"$ref": "#/$defs/nullableString"}
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accounting_model",
        "base_currency",
        "calendar",
        "calendar_timezone",
        "cost_models",
        "data_adjustment_policy",
        "execution_model",
        "execution_timing",
        "fractional_quantity_allowed",
        "initial_cash",
        "shorting_allowed"
      ],
      "properties": {
        "accounting_model": {"$ref": "#/$defs/model"},
        "base_currency": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{2,11}$"},
        "calendar": {"$ref": "#/$defs/nonEmptyString"},
        "calendar_timezone": {"$ref": "#/$defs/nonEmptyString"},
        "cost_models": {
          "type": "array",
          "items": {"$ref": "#/$defs/model"}
        },
        "data_adjustment_policy": {"$ref": "#/$defs/nonEmptyString"},
        "execution_model": {"$ref": "#/$defs/model"},
        "execution_timing": {"$ref": "#/$defs/nonEmptyString"},
        "fractional_quantity_allowed": {"type": "boolean"},
        "initial_cash": {"$ref": "#/$defs/decimal"},
        "shorting_allowed": {"type": "boolean"}
      }
    }
  }
}
