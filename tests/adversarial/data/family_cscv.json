  "findings": [
    {
      "category": "methodological_risk",
      "claim": "No declared train/test or fold membership was supplied.",
      "code": "EXPERIMENT_SPLIT_METADATA_NOT_SUPPLIED",
      "implication": "The family remains usable for DSR and internally constructed CSCV, but it cannot preserve an external train/test design.",
      "remediation": "Supply the optional split-membership CSV when the research process used named train/test folds."
    },
    {
      "category": "statistical_evidence",
      "claim": "The selection-eligible-count DSR does not meet the configured confidence requirement.",
      "code": "DSR_CONFIDENCE_REQUIREMENT_NOT_MET",
      "implication": "The selected Sharpe is not sufficiently exceptional under the classical independent-trials search adjustment and stated assumptions.",
      "remediation": "Treat the result as insufficient evidence; do not add data or trials solely to chase the threshold."
    },
    {
      "category": "methodological_risk",
      "claim": "The primary classical DSR scenario treats every selection-eligible trial as independent.",
      "code": "DSR_INDEPENDENT_TRIALS_APPROXIMATION",
      "implication": "Correlated strategy variants can make the literal trial count differ from the number of effectively independent tests; the reported correlation summary is evidence, not an automatic effective-count estimator.",
      "remediation": "Interpret the declared-attempt sensitivity and, when an independence analysis exists, supply its effective count with a methodology statement."
    },
    {
      "category": "methodological_risk",
      "claim": "Classical DSR is an asymptotic plug-in estimate using the observed cross-trial dispersion and selected-trial moments.",
      "code": "DSR_ASYMPTOTIC_PLUGIN_INFERENCE",
      "implication": "Short histories, few trials, and unstable skewness or kurtosis estimates can materially change the reported probability.",
      "remediation": "Interpret DSR with the observation and trial counts shown in the report and retain independent robustness evidence."
    },
    {
      "category": "methodological_risk",
      "claim": "The classical DSR standard error does not apply a HAC or other serial-dependence correction.",
      "code": "DSR_SERIAL_DEPENDENCE_NOT_ADJUSTED",
      "implication": "Serially dependent returns can make the IID-style DSR uncertainty estimate unreliable.",
      "remediation": "Interpret DSR alongside serial-dependence evidence; do not treat it as a replacement for the Part H adjustment."
    },
    {
      "category": "statistical_evidence",
      "claim": "The estimated PBO exceeds the configured maximum acceptable value.",
      "code": "PBO_REQUIREMENT_NOT_MET",
      "implication": "In-sample winners rank at or below the OOS median too frequently for the stated requirement.",
      "remediation": "Treat this as adverse selection-process evidence; do not optimize strategy parameters against PBO."
    },
    {
      "category": "methodological_risk",
      "claim": "The CSCV universe contains ten or fewer eligible trials.",
      "code": "PBO_RANK_GRANULARITY_LIMITED",
      "implication": "The relative ranks and logits have limited resolution.",
      "remediation": "Interpret the split-level rank distribution shown."
    },
    {
      "category": "methodological_risk",
      "claim": "The partition count produces fewer than 100 logits.",
      "code": "PBO_COMBINATION_RESOLUTION_LIMITED",
      "implication": "The empirical PBO frequency is coarse.",
      "remediation": "Choose partitions from history and time structure, not to obtain a preferred PBO."
    },
    {
      "category": "methodological_risk",
      "claim": "CSCV recombines contiguous partitions and does not remove serial dependence or structural breaks.",
      "code": "CSCV_TIME_DEPENDENCE_LIMITATION",
      "implication": "Partition size and regime coverage can affect logits.",
      "remediation": "Interpret PBO with temporal robustness evidence."
    },
    {
      "category": "methodological_risk",
      "claim": "PBO is an audit diagnostic, not an optimization objective.",
      "code": "CSCV_NOT_A_SELECTION_OBJECTIVE",
      "implication": "Optimizing against PBO would overfit the diagnostic.",
      "remediation": "Freeze the search and CSCV configuration in advance."
    },
    {
      "category": "methodological_risk",
      "claim": "Local parameter-neighborhood robustness was not configured.",
      "code": "PARAMETER_ROBUSTNESS_NOT_CONFIGURED",
      "implication": "The report does not show whether nearby tested configurations form a plateau or a performance cliff.",
      "remediation": "Supply explicit parameter scales, a distance radius, and acceptance requirements when neighborhood evidence is required."
    },
    {
      "category": "methodological_risk",
      "claim": "Equal-window temporal robustness was not configured.",
      "code": "TEMPORAL_ROBUSTNESS_NOT_CONFIGURED",
      "implication": "The report does not show whether selected-trial rank and sign are consistent through the audited history.",
      "remediation": "Supply the complete explicit temporal configuration."
    }
